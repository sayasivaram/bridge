# Copy this file to .env (in this folder, or the folder one level above it)
# and fill in ONE of these keys. Never commit your real .env.

# Course key via Portkey. The app always uses the model gpt-6-luna.
PORTKEY_API_KEY=

# Optional: your own OpenAI key (used only if PORTKEY_API_KEY is empty).
OPENAI_API_KEY=
